      "purpose": "`barcode` is a standards-driven Go library for validating, encoding, rendering, and decoding common one-dimensional and two-dimensional barcodes. Its core values are immutable logical modules; PNG, SVG, and `image.Image` output are derived views rather than the source of truth.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "domain-utilities",
      "family_label": "Domain Utilities",
      "family_description": "Domain-specific immutable values, algorithms, parsers, proofs, and calculations.",
      "family_order": 8,
      "cohesion": {
        "family": "domain-utilities",
        "secondary_capabilities": [
          "data-encoding",
          "protocols-and-schemas",
          "testing-and-conformance"
        ],
        "responsibility": "Provide immutable logical barcode symbols, strict validation, encoding, decoding, rendering, and standards-conformance evidence.",
        "non_goals": [
          "Own barcode hardware or scanner lifecycles, certify physical devices or print quality, or assemble multi-symbol Data Matrix and PDF417 sequences."
        ],
        "public_package_identifier": "none",
