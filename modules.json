        "package_selection": {
          "github.com/faustbrian/go-barcode/aztec": "Use for strict Aztec Code encoding and decoding.",
          "github.com/faustbrian/go-barcode/barcode": "Use for shared immutable symbol, matrix, format, capability, and error primitives.",
          "github.com/faustbrian/go-barcode/codabar": "Use for strict Codabar encoding and decoding without an invented optional checksum profile.",
          "github.com/faustbrian/go-barcode/code128": "Use for Code 128, GS1-128, FNC1, ECI, and structured-append encoding and decoding.",
          "github.com/faustbrian/go-barcode/code39": "Use for Code 39 encoding and decoding with explicit checksum policy.",
          "github.com/faustbrian/go-barcode/code93": "Use for Code 93 encoding and decoding with mandatory checksums.",
          "github.com/faustbrian/go-barcode/datamatrix": "Use for bounded Data Matrix ECC 200 symbol encoding and decoding.",
          "github.com/faustbrian/go-barcode/ean": "Use for validated EAN-8 and EAN-13 encoding and decoding.",
          "github.com/faustbrian/go-barcode/gs1": "Use for bounded GS1 element-string parsing, validation, and carrier data.",
          "github.com/faustbrian/go-barcode/imagedecode": "Use for bounded image detection and decoding of supported barcode formats.",
          "github.com/faustbrian/go-barcode/itf": "Use for Interleaved 2 of 5 and ITF-14 encoding and decoding.",
          "github.com/faustbrian/go-barcode/pdf417": "Use for bounded PDF417 symbol encoding and decoding.",
          "github.com/faustbrian/go-barcode/qr": "Use for strict QR Code encoding and decoding with explicit controls.",
          "github.com/faustbrian/go-barcode/render": "Use to derive PNG, SVG, or image output from immutable logical symbols.",
          "github.com/faustbrian/go-barcode/specification": "Use to inspect the package's pinned standards catalogue and capability evidence.",
          "github.com/faustbrian/go-barcode/upc": "Use for validated UPC-A and UPC-E encoding and decoding."
        },
